# Field reference only; generate separate credentials on each machine.
# WSL: bash scripts/new-local-env.sh
# Windows alternative: scripts/new-local-env.ps1
# Do not copy this file as working credentials or share the generated .env.
JWT_ISSUER=local-gateway
JWT_AUDIENCE=gateway-sample-api
JWT_SECRET=
JWT_TTL=1h
DEMO_USERNAME=demo
DEMO_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# Optional stage 12: bash scripts/ensure-persistence-env.sh generates this value.
POSTGRES_PASSWORD=

# Optional stage 16: python3 scripts/ensure-keycloak-env.py generates these values.
KC_DB_PASSWORD=
KC_BOOTSTRAP_PASSWORD=
KC_DEMO_PASSWORD=
KC_LAB_ADMIN_PASSWORD=
KC_READER_SECRET=
KC_WRITER_SECRET=
