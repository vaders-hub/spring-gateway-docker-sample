<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.backend.member.repository.mybatis.MemberSqlMapper">
  <resultMap id="member" type="com.example.backend.member.model.Member">
    <constructor>
      <idArg name="id" column="id" javaType="_long"/>
      <arg name="displayName" column="display_name" javaType="string"/>
    </constructor>
  </resultMap>
  <select id="findAll" resultMap="member">
    SELECT id, display_name FROM members ORDER BY id
  </select>
  <select id="findById" resultMap="member">
    SELECT id, display_name FROM members WHERE id = #{id}
  </select>
</mapper>
